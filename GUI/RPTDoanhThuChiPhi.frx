    <MsSqlDataConnection Name="Connection1" ConnectionString="rijcmlqM3/HbiZANEYP3Y6oNtE7mrUmT0ytl94C6DYS4DXvgc8JqhVjVQGe7Sc2pOMNI3eDn1YRBP4jHG4oH35kOWhzHPbQmZ/eP5ifH51UTgzbbI8cfI027dkwR2PyRG9bznctcDmX6v+vHXlluURRYR9h4D0VFraLcO8J/kv7Cq/s0rIKxMko7YOQssDbbNJzyd9502B4lMwQ/DMEsSzOYLMzfg==">
      <TableDataSource Name="Table" Alias="FINANCIAL_SUMMARY" DataType="System.Int32" Enabled="true" SelectCommand="SELECT&#13;&#10;    F.TotalRevenue,&#13;&#10;    F.IngredientCost,&#13;&#10;    F.SalaryCost,&#13;&#10;    F.ElectricityCost,&#13;&#10;    F.WaterCost,&#13;&#10;    F.RentCost,&#13;&#10;    F.OtherCost,&#13;&#10;    (F.TotalRevenue - (F.IngredientCost + F.SalaryCost + F.ElectricityCost + F.WaterCost + F.RentCost + F.OtherCost)) AS Profit,&#13;&#10;    F.ReportMonth,&#13;&#10;    F.ReportYear,&#13;&#10;    B.BranchName&#13;&#10;FROM FINANCIAL F&#13;&#10;JOIN BRANCH B ON F.BranchId = B.Id&#13;&#10;WHERE F.ReportMonth = @pThang AND F.ReportYear = @pNam">
        <Column Name="TotalRevenue" DataType="System.Decimal"/>
        <Column Name="IngredientCost" DataType="System.Decimal"/>
        <Column Name="SalaryCost" DataType="System.Decimal"/>
        <Column Name="ElectricityCost" DataType="System.Decimal"/>
        <Column Name="WaterCost" DataType="System.Decimal"/>
        <Column Name="RentCost" DataType="System.Decimal"/>
        <Column Name="OtherCost" DataType="System.Decimal"/>
        <Column Name="Profit" DataType="System.Decimal"/>
        <Column Name="ReportMonth" DataType="System.Int32"/>
        <Column Name="ReportYear" DataType="System.Int32"/>
        <Column Name="BranchName" DataType="System.String"/>
        <CommandParameter Name="pThang" DataType="22"/>
        <CommandParameter Name="pNam" DataType="22"/>
      </TableDataSource>
      <TableDataSource Name="Table3" Alias="NGUYEN_LIEU_NHAP" DataType="System.Int32" Enabled="true" SelectCommand="SELECT &#13;&#10;    ROW_NUMBER() OVER (ORDER BY SR.ReceiptDate, I.IngredientName) AS STT,&#13;&#10;    I.IngredientName,&#13;&#10;    SR.UnitPrice,&#13;&#10;    SR.Quantity,&#13;&#10;    SR.TotalPrice,&#13;&#10;    FORMAT(SR.ReceiptDate, 'dd/MM/yyyy') AS NgayNhap,&#13;&#10;    S.Name AS NhaCungCap&#13;&#10;FROM STOCK_RECEIPT SR&#13;&#10;JOIN INGREDIENT I ON SR.IngredientId = I.Id&#13;&#10;LEFT JOIN SUPPLIER S ON SR.SupplierId = S.Id&#13;&#10;WHERE MONTH(SR.ReceiptDate) = 11 &#13;&#10;  AND YEAR(SR.ReceiptDate) = 2025&#13;&#10;ORDER BY SR.ReceiptDate, I.IngredientName">
        <Column Name="STT" DataType="System.Int64"/>
        <Column Name="IngredientName" DataType="System.String"/>
        <Column Name="UnitPrice" DataType="System.Decimal"/>
        <Column Name="Quantity" DataType="System.Int32"/>
        <Column Name="TotalPrice" DataType="System.Decimal"/>
        <Column Name="NgayNhap" DataType="System.String"/>
        <Column Name="NhaCungCap" DataType="System.String"/>
      </TableDataSource>
      <TableDataSource Name="Table6" Alias="LUONG_NHAN_VIEN" DataType="System.Int32" Enabled="true" SelectCommand="-- Cách tính lương chính xác nhất theo hệ thống bạn đang có&#13;&#10;SELECT &#13;&#10;    ROW_NUMBER() OVER (ORDER BY E.EmployeeName) AS STT,&#13;&#10;    E.EmployeeName,&#13;&#10;    E.SalaryPerHour,&#13;&#10;    ISNULL(SUM(A.OvertimeHours),0) AS TongGioTangCa,&#13;&#10;    ISNULL(SUM(&#13;&#10;        DATEDIFF(MINUTE, WS.StartTime, WS.EndTime) / 60.0   -- giờ làm bình thường&#13;&#10;        + A.OvertimeHours                                   -- cộng tăng ca&#13;&#10;    ), 0) AS TongGioLam,&#13;&#10;    E.SalaryPerHour * ISNULL(SUM(&#13;&#10;        DATEDIFF(MINUTE, WS.StartTime, WS.EndTime) / 60.0 + A.OvertimeHours&#13;&#10;    ), 0) AS TongLuong&#13;&#10;FROM EMPLOYEE E&#13;&#10;LEFT JOIN ATTENDANCE A ON E.Id = A.EmployeeId&#13;&#10;LEFT JOIN WORK_SHIFT WS ON A.ShiftId = WS.Id&#13;&#10;WHERE MONTH(A.CheckIn) = 11 AND YEAR(A.CheckIn) = 2025   -- đổi tháng năm ở đây luôn&#13;&#10;  AND E.CurrentStatus = N'Đang làm việc'&#13;&#10;GROUP BY E.Id, E.EmployeeName, E.SalaryPerHour&#13;&#10;ORDER BY E.EmployeeName">
        <Column Name="STT" DataType="System.Int64"/>
        <Column Name="EmployeeName" DataType="System.String"/>
        <Column Name="SalaryPerHour" DataType="System.Decimal"/>
        <Column Name="TongGioTangCa" DataType="System.Decimal"/>
        <Column Name="TongGioLam" DataType="System.Decimal"/>
        <Column Name="TongLuong" DataType="System.Decimal"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="pThang" DataType="System.Int32" AsString=""/>
    <Parameter Name="pNam" DataType="System.Int32" AsString=""/>
    <Parameter Name="TongChiPhi" DataType="System.Int32" AsString=""/>
    <Parameter Name="LoiNhuan" DataType="System.Int32" AsString=""/>
    <Parameter Name="pNguoiBaoCao" DataType="System.String" AsString=""/>
    <Parameter Name="pNgayIn" DataType="System.DateTime" AsString=""/>
  </Dictionary>

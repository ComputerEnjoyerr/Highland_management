      <TableDataSource Name="INGREDIENT" DataType="System.Int32" Enabled="true" TableName="INGREDIENT">
        <Column Name="Id" DataType="System.String"/>
        <Column Name="IngredientName" DataType="System.String"/>
      </TableDataSource>
      <TableDataSource Name="RECIPE" DataType="System.Int32" Enabled="true" TableName="RECIPE">
        <Column Name="Id" DataType="System.String"/>
        <Column Name="IngredientId" DataType="System.String"/>
        <Column Name="ProductId" DataType="System.String"/>
        <Column Name="Quantity" DataType="System.Decimal" Format="Number"/>
        <Column Name="RecipeUnitId" DataType="System.Int32"/>
      </TableDataSource>
      <TableDataSource Name="Table" Alias="RecipeDetail" DataType="System.Int32" Enabled="true" SelectCommand="SELECT &#13;&#10;    P.Id AS ProductId,&#13;&#10;    P.ProductName,&#13;&#10;    I.IngredientName,&#13;&#10;    R.Quantity,&#13;&#10;    U.UnitName&#13;&#10;FROM RECIPE R&#13;&#10;JOIN PRODUCTS P ON R.ProductId = P.Id&#13;&#10;JOIN INGREDIENT I ON R.IngredientId = I.Id&#13;&#10;JOIN UNIT U ON R.RecipeUnitId = U.Id&#13;&#10;ORDER BY P.ProductName, I.IngredientName;">
        <Column Name="ProductId" DataType="System.String"/>
        <Column Name="ProductName" DataType="System.String"/>
        <Column Name="IngredientName" DataType="System.String"/>
        <Column Name="Quantity" DataType="System.Decimal"/>
        <Column Name="UnitName" DataType="System.String"/>
      </TableDataSource>
    </MsSqlDataConnection>
